<% content_for :title, "Add Set" %>

<h1>Add a set to <%= @collection.name %></h1>

<%= form_with model: [@collection, @owned_set] do |form| %>
  <% if @owned_set.errors.any? %>
    <div>
      <h2><%= pluralize(@owned_set.errors.count, "error") %> prevented saving:</h2>
      <ul>
        <% @owned_set.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :catalog_product_id, "Set" %>
    <%= form.collection_select :catalog_product_id, @catalog_products, :id, :name,
                               { prompt: "Choose a set" }, required: true %>
  </div>

  <div>
    <%= form.label :quantity, "Number of boxes" %>
    <%= form.number_field :quantity, min: 1, required: true, value: @owned_set.quantity || 1 %>
  </div>

  <div>
    <%= form.submit "Add set" %>
  </div>
<% end %>

<%= link_to "Back to collection", @collection %>
