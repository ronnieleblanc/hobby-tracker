<% content_for :title, @collection.name %>

<h1><%= @collection.name %></h1>

<%= link_to "Add a set", new_collection_owned_set_path(@collection) %>
<%= link_to "Add individual models", new_collection_miniature_path(@collection) %>

<h2>Progress</h2>
<ul>
  <% @collection.status_counts.each do |status, count| %>
    <li><%= status.humanize %>: <%= count %></li>
  <% end %>
</ul>

<h2>Owned sets</h2>
<% if @owned_sets.any? %>
  <ul>
    <% @owned_sets.each do |owned_set| %>
      <li>
        <%= link_to owned_set.catalog_product.name,
                    collection_owned_set_path(@collection, owned_set) %>
        × <%= owned_set.quantity %>
        (<%= owned_set.miniatures.count %> miniatures, <%= owned_set.progress_percentage %>% complete)
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No sets added yet.</p>
<% end %>

<h2>Standalone miniatures</h2>
<% if @standalone_miniatures.any? %>
  <% @standalone_miniatures.group_by { |miniature| miniature.catalog_unit.faction }.each do |faction, miniatures| %>
    <h3><%= faction.name %></h3>
    <ul>
      <% miniatures.group_by(&:catalog_unit).each do |catalog_unit, unit_miniatures| %>
        <li>
          <details>
            <summary>
              <%= catalog_unit.name %> × <%= unit_miniatures.size %>
              (<%= unit_miniatures.count(&:finished?) %> finished)
            </summary>
            <%= form_with url: collection_update_miniatures_status_path(@collection),
                          method: :post do |form| %>
              <%= form.hidden_field :catalog_unit_id, value: catalog_unit.id %>
              <%= form.select :status, Miniature.statuses.keys.map { |status| [status.humanize, status] } %>
              <%= form.submit "Update all" %>
            <% end %>
            <%= button_to "Remove all",
                          collection_delete_miniatures_group_path(@collection),
                          method: :delete,
                          params: { catalog_unit_id: catalog_unit.id },
                          data: { turbo_confirm: "Remove all #{catalog_unit.name} miniatures?" } %>
            <ul>
              <% unit_miniatures.each do |miniature| %>
                <li><%= link_to miniature.name, collection_miniature_path(@collection, miniature) %>
                  <%= form_with model: [@collection, miniature] do |form| %>
                    <%= form.select :status,
                                   Miniature.statuses.keys.map { |status| [status.humanize, status] } %>
                    <%= form.submit "Save" %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </details>
        </li>
      <% end %>
    </ul>
  <% end %>
<% else %>
  <p>No standalone miniatures added yet.</p>
<% end %>
