<% content_for :title, @miniature.name %>

<h1><%= @miniature.name %></h1>
<p>Collection: <%= link_to @collection.name, @collection %></p>
<p>Status: <%= @miniature.status.humanize %></p>

<%= link_to "Update status", edit_collection_miniature_path(@collection, @miniature) %>
<% if @miniature.owned_set.nil? %>
  <%= button_to "Remove miniature", [@collection, @miniature], method: :delete,
                data: { turbo_confirm: "Remove this standalone miniature?" } %>
<% end %>
<%= link_to "Back to collection", @collection %>
